# Version compatible with Angular 22.1.x.
NODE_VERSION=24.15.0

# Host ports used by the development server and the production-like preview.
FRONTEND_DEV_PORT=4200
FRONTEND_WEB_PORT=8081

# Network created by ../GAM-Backend/compose.dev.yaml.
GAM_BACKEND_NETWORK=gam-dev_gam-dev

# Service URL visible from the frontend container.
API_UPSTREAM=http://gateway:8080

# Polling is reliable for bind mounts on Docker Desktop.
WATCH_POLL_INTERVAL=2000
